# QQ 邮件桥环境变量（复制为 /opt/qq-push/.env，chmod 600，<> 含括号一起替换）
# 注意：此文件含密钥，仅 root 可读

# QQ 机器人
QQ_BOT_APPID=<机器人AppID>
QQ_BOT_SECRET=<机器人AppSecret>
QQ_USER_OPENID=<你的user_openid，用 get_openid.py 拿到>

# 本地中转鉴权（自己编的随机长字符串，轮询和中转用同一个）
PUSH_API_KEY=<自己编的随机长字符串>

# QQ邮箱
QQ_MAIL_USER=<你的QQ邮箱>
QQ_MAIL_AUTHCODE=<QQ邮箱授权码>

# 邮件桥约定
EXPECTED_FROM=<助手的Gmail地址>
FORWARD_TO=<助手的Gmail地址>
